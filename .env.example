# Copy to .env and fill in what you need. Never commit .env.
# Priority: env vars > .env.<env> > .env > defaults

# Profile: dev | test | prod  (also selects .env.dev / .env.test / .env.prod)
AGENTFORGE_ENV=dev

# Logging
AGENTFORGE_LOGGING__LEVEL=INFO        # DEBUG | INFO | WARNING | ERROR | CRITICAL
AGENTFORGE_LOGGING__FORMAT=console    # console | json

# LLM
AGENTFORGE_LLM__PROVIDER=fake         # anthropic | openai | ollama | fake
AGENTFORGE_LLM__MODEL=fake-model
AGENTFORGE_LLM__TIMEOUT_S=60
AGENTFORGE_LLM__MAX_RETRIES=3
AGENTFORGE_LLM__OLLAMA_BASE_URL=http://localhost:11434

# Response cache: off | memory | disk | replay (replay = recorded responses only, never call the API)
AGENTFORGE_LLM__CACHE=off
AGENTFORGE_LLM__CACHE_DIR=.cache/llm

# Examples:
#   Anthropic:  AGENTFORGE_LLM__PROVIDER=anthropic  AGENTFORGE_LLM__MODEL=claude-haiku-4-5
#   OpenAI:     AGENTFORGE_LLM__PROVIDER=openai     AGENTFORGE_LLM__MODEL=gpt-5-mini
#   Local:      AGENTFORGE_LLM__PROVIDER=ollama     AGENTFORGE_LLM__MODEL=llama3.2  (after `ollama pull llama3.2`)

# Provider keys (the standard names without the prefix also work)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
